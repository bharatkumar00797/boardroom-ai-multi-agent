# LLM provider: mock (default, offline, deterministic) | openai | groq | ollama
BOARDROOM_PROVIDER=mock
BOARDROOM_BASE_URL=https://api.openai.com/v1
BOARDROOM_API_KEY=
BOARDROOM_MODEL=gpt-4o-mini
# Debate rounds after the opening statements (critique/revision rounds), 1-5
BOARDROOM_ROUNDS=2

# --- HTTP service (boardroom serve) ---
# Comma-separated API keys; when set every /api call needs X-API-Key or Authorization: Bearer
BOARDROOM_API_KEYS=
# Dev mode: no auth, full access (localhost only). With no keys and no dev mode the service
# runs as a public demo (packaged scenarios + mock provider only).
BOARDROOM_DEV_MODE=false
BOARDROOM_CORS_ORIGINS=
BOARDROOM_RATE_LIMIT_PER_MINUTE=120
BOARDROOM_DECISION_LIMIT_PER_MINUTE=10
BOARDROOM_MAX_CONCURRENT_RUNS=2
BOARDROOM_MAX_QUEUED_RUNS=8
BOARDROOM_MAX_DECISIONS_KEPT=200
# Only enable behind a reverse proxy you control (uses the right-most X-Forwarded-For hop)
BOARDROOM_TRUST_PROXY=false
# Run debates inside the request (auto-on for Vercel / AWS Lambda)
BOARDROOM_SYNC_RUNS=false
